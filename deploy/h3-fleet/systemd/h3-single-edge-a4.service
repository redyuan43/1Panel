User=admin
Slice=h3-edge-compute.slice
WorkingDirectory=/home/admin/.local/state/h3-edge-fleet-20260914/runtime
Environment=CUDA_VISIBLE_DEVICES=GPU-95675338-26b9-4ddf-1cc9-e449db82e19e
Environment=PYTHONUNBUFFERED=1
