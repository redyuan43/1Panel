+#pragma once
+
+// Experimental, local-only companion format. A SHA-256 manifest published by
+// the lab tool binds this file to the target/draft files and exact runtime.
+// The backend also validates structure and per-blob checksums before loading.
+#include "common.h"
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static bool lab_disk_checkpoints_enabled() {
+    const char * value = std::getenv("LLAMA_LAB_DISK_CHECKPOINTS");
+    return value && std::string(value) == "1";
+}
+
+namespace lab_checkpoint_io {
+constexpr uint64_t magic = UINT64_C(0x3154504b434e584e); // NXNCKPT1, native endian
+constexpr uint64_t max_blob = UINT64_C(512) * 1024 * 1024;
+
+template<class T> void write_value(std::ostream & out, T value) {
+    out.write(reinterpret_cast<const char *>(&value), sizeof(value));
+    if (!out) throw std::runtime_error("checkpoint write failed");
+}
+template<class T> T read_value(std::istream & in) {
+    T value{};
+    in.read(reinterpret_cast<char *>(&value), sizeof(value));
+    if (!in) throw std::runtime_error("truncated checkpoint metadata");
+    return value;
+}
+static uint64_t checksum(const std::vector<uint8_t> & data) {
+    uint64_t hash = UINT64_C(14695981039346656037);
+    for (uint8_t c : data) { hash ^= c; hash *= UINT64_C(1099511628211); }
+    return hash;
+}
+static void write_blob(std::ostream & out, const std::vector<uint8_t> & data) {
+    if (data.size() > max_blob) throw std::runtime_error("checkpoint blob exceeds lab limit");
+    write_value<uint64_t>(out, data.size());
+    write_value<uint64_t>(out, checksum(data));
+    if (!data.empty()) out.write(reinterpret_cast<const char *>(data.data()), data.size());
+    if (!out) throw std::runtime_error("checkpoint blob write failed");
+}
+static std::vector<uint8_t> read_blob(std::istream & in) {
+    const uint64_t size = read_value<uint64_t>(in);
+    const uint64_t expected = read_value<uint64_t>(in);
+    const auto begin = in.tellg();
+    in.seekg(0, std::ios::end);
+    const auto end = in.tellg();
+    in.seekg(begin);
+    if (!in || size > max_blob || end < begin || size > static_cast<uint64_t>(end-begin))
+        throw std::runtime_error("invalid checkpoint blob length");
+    std::vector<uint8_t> data(size);
+    if (size) in.read(reinterpret_cast<char *>(data.data()), size);
+    if (!in || checksum(data) != expected) throw std::runtime_error("checkpoint checksum mismatch");
+    return data;
+}
+
+struct bundle {
+    std::list<common_prompt_checkpoint> checkpoints;
+    std::vector<uint8_t> speculative;
+};
+
+static void save(const std::string & path, int64_t tokens, int64_t context,
+                 bool draft, const std::list<common_prompt_checkpoint> & checkpoints,
+                 const std::vector<uint8_t> & speculative) {
+    if (checkpoints.empty()) throw std::runtime_error("no usable context checkpoints to persist");
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    if (!out) throw std::runtime_error("cannot open checkpoint companion");
+    write_value(out, magic);
+    write_value<int64_t>(out, tokens);
+    write_value<int64_t>(out, context);
+    write_value<uint64_t>(out, draft ? 1 : 0);
+    write_value<uint64_t>(out, checkpoints.size());
+    for (const auto & cp : checkpoints) {
+        write_value<int64_t>(out, cp.n_tokens);
+        write_value<int64_t>(out, cp.pos_min);
+        write_value<int64_t>(out, cp.pos_max);
+        write_blob(out, cp.data_tgt);
+        write_blob(out, cp.data_dft);
+        write_blob(out, cp.data_spec);
+    }
+    write_blob(out, speculative);
+    out.flush();
+    if (!out) throw std::runtime_error("checkpoint flush failed");
+}
+
+static bundle load(const std::string & path, int64_t tokens, int64_t context,
+                   bool draft, size_t max_count) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) throw std::runtime_error("missing checkpoint companion");
+    if (read_value<uint64_t>(in) != magic || read_value<int64_t>(in) != tokens ||
+        read_value<int64_t>(in) != context || read_value<uint64_t>(in) != (draft ? 1u : 0u))
+        throw std::runtime_error("incompatible checkpoint metadata");
+    const uint64_t count = read_value<uint64_t>(in);
+    if (!count || count > max_count) throw std::runtime_error("invalid checkpoint count");
+    bundle result;
+    for (uint64_t i = 0; i < count; ++i) {
+        common_prompt_checkpoint cp{};
+        cp.n_tokens = read_value<int64_t>(in);
+        const int64_t lo = read_value<int64_t>(in);
+        const int64_t hi = read_value<int64_t>(in);
+        if (cp.n_tokens <= 0 || cp.n_tokens > tokens || lo < 0 || hi < lo || hi >= context)
+            throw std::runtime_error("invalid checkpoint positions");
+        cp.pos_min = static_cast<llama_pos>(lo);
+        cp.pos_max = static_cast<llama_pos>(hi);
+        cp.id_task = -1; // old task IDs have no meaning in a new process
+        cp.data_tgt = read_blob(in);
+        cp.data_dft = read_blob(in);
+        cp.data_spec = read_blob(in);
+        if (cp.data_tgt.empty() || (draft && cp.data_dft.empty()))
+            throw std::runtime_error("incomplete checkpoint state");
+        result.checkpoints.push_back(std::move(cp));
+    }
+    result.speculative = read_blob(in);
+    if (in.peek() != std::char_traits<char>::eof()) throw std::runtime_error("trailing checkpoint data");
+    return result;
+}
+} // namespace lab_checkpoint_io

