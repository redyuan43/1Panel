[Unit]
Description=NX3 Qwen3.6 persistent prefix cache gateway
Requires=nx3-qwen36.service
After=nx3-qwen36.service
PartOf=nx3-qwen36.service
[Service]
Type=simple
User=nx
WorkingDirectory=/home/nx/llama/prefix-cache-production
ExecStart=/usr/bin/python3 /home/nx/llama/prefix-cache-production/qwen36_prefix_gateway.py --config /home/nx/llama/prefix-cache-production/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
UMask=0077
[Install]
WantedBy=multi-user.target
