[Unit]
Description=Qwen3.8 EfficientThink TP4 from verified immutable release
After=network-online.target qwen38-v100-tp2-lmcache.service
Requires=qwen38-v100-tp2-lmcache.service
BindsTo=qwen38-v100-tp2-lmcache.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.local/state/1panel-runtime/current/qwen38/env/qwen38-et-w4a16-mtp2.env
ExecStartPre=/usr/bin/python3 %h/.local/state/1panel-runtime/current/tools/release.py verify --release %h/.local/state/1panel-runtime/current --external-component qwen-python --external-component qwen-venv
ExecStartPre=/home/ai/venvs/1cat-vllm-1.5.0-lmcache/bin/python %h/.local/state/1panel-runtime/current/qwen38/runtime/check-qwen38-v100-tp2-lmcache.py --config %h/.local/state/1panel-runtime/current/qwen38/config/lmcache.yaml --require-vllm-guards
ExecStart=%h/.local/state/1panel-runtime/current/qwen38/runtime/run-qwen38-v100-tp2-container.sh
ExecStop=-/usr/bin/docker stop --time 300 qwen38-v100-tp2-vllm
Restart=on-failure
RestartSec=15
TimeoutStartSec=1800
TimeoutStopSec=300
KillMode=mixed
LimitNOFILE=65535
LimitMEMLOCK=infinity

[Install]
WantedBy=default.target
