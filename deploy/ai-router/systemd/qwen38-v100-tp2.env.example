SERVER_BIN=/home/ai/venvs/1cat-vllm-1.5.0/bin/vllm
CONTAINER_NAME=qwen38-v100-tp2-vllm
LMCACHE_CONTAINER_NAME=qwen38-v100-tp2-lmcache
CONTAINER_IMAGE=docker.io/nvidia/cuda@sha256:520292dbb4f755fd360766059e62956e9379485d9e073bbd2f6e3c20c270ed66
PYTHON_RUNTIME=/home/ai/runtimes/python-3.12.14-20260901
VLLM_VENV=/home/ai/venvs/1cat-vllm-1.5.0
BASE_VLLM_VENV=/home/ai/venvs/1cat-vllm-1.5.0
LMCACHE_VENV=/home/ai/venvs/1cat-vllm-1.5.0-lmcache
LMCACHE_CACHE_ROOT=/home/ai/.cache/1cat-vllm-1.5.0-lmcache
LMCACHE_NUMBA_CACHE_DIR=/home/ai/.cache/1cat-vllm-1.5.0-lmcache/numba
LMCACHE_CUDA_CACHE_PATH=/home/ai/.cache/1cat-vllm-1.5.0-lmcache/cuda
MODEL_PATH=/home/ai/model-sources/modelscope/QUASAR-QAT/Qwen3.8-27B-QUASAR-NVFP4
DRAFT_MODEL_PATH=
SERVED_MODEL_NAME=siyuan/qwen38-v100-196k
GPU_UUIDS=GPU-008619db-68ab-5b8f-bf82-8fcd838af68b,GPU-cc874591-ffb9-839d-8f63-23e8613bc0e6
PIPELINE_PARALLEL_SIZE=1
TENSOR_PARALLEL_SIZE=2
HOST=127.0.0.1
PORT=18107
MAX_MODEL_LEN=196608
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8_e5m2
SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":2}
AI_ROUTER_DEFAULTS_PATH=/home/ai/github/1Panel/deploy/ai-router/config/defaults.yaml
AI_ROUTER_RUNTIME_SETTINGS_PATH=/opt/1panel/ai-router/settings.yaml
# Optional emergency override. Normally the persisted Router settings are used.
# LMCACHE_ENABLED=0
# LMCACHE_SERVER_URL=tcp://127.0.0.1:6555
# KV_TRANSFER_CONFIG={"kv_connector":"LMCacheMPConnector","kv_role":"kv_both","kv_connector_module_path":"lmcache.integration.vllm.lmcache_mp_connector","kv_connector_extra_config":{"lmcache.mp.host":"tcp://127.0.0.1","lmcache.mp.port":6555,"lmcache.mp.heartbeat_interval":10,"lmcache.mp.mp_transfer_mode":"lmcache_driven"}}
ATTENTION_BACKEND=FLASH_ATTN_V100
ENFORCE_EAGER=0
# The mixed V100/PG500 pair can deadlock in vLLM's custom IPC all-reduce
# after an LMCache lifecycle change. NCCL P2P remains enabled.
DISABLE_CUSTOM_ALL_REDUCE=1
# Temporary recovery switch if a CUDA-IPC attempt leaves peer access stuck.
# Re-test with check-v100-tp2-nccl.py after the next host reboot.
NCCL_P2P_DISABLE=1
VLLM_SM70_QUANT_BACKEND=auto
API_KEY_FILE=/home/ai/.config/1cat-vllm/api-key
VLLM_CACHE_ROOT=/home/ai/.cache/1cat-vllm-1.5.0
CONTAINER_HOME=/home/ai/.cache/1cat-vllm-1.5.0/home
