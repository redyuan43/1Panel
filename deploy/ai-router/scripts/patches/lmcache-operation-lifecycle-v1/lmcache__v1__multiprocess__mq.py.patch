+    def _close_on_owner(self):
+        # Called only by ClientPollingLoop, after removing the socket from poll.
+        with self._submission_lock:
+            self._closing = True
+        for future in self.pending_futures.values():
+            future.set_exception(RemoteOperationError("outcome_unknown_closed"))
+        self.pending_futures.clear()
+        self._pending_deadlines.clear()
+        self._pending_request_types.clear()
+        while True:
+            try:
+                wrapped = self.input_queue.get_nowait()
+            except queue.Empty:
+                break
+            wrapped.future.set_exception(RemoteOperationError("not_started"))
+        self.socket.close(linger=0)
+
+    def close(self):
+        with self._submission_lock:
+            leader = not self._close_requested
+            self._close_requested = True
+            self._closing = True
+        if not leader:
+            self._close_done.wait()
+            return
+        try:
+            self._polling_loop.unregister(self)
+            ClientPollingLoop.release_instance()
+        finally:
+            self._close_done.set()
 
 
