[Unit]
Description=Qwen3.8 Flash-Next NVFP4 vLLM server with disk prefix cache
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/home/admin/github/qwen3.8_flash_next/scripts/preflight_runtime.sh
ExecStart=/home/admin/github/qwen3.8_flash_next/scripts/serve_flash_disk_cache.sh
ExecStop=-/usr/bin/sudo -n /usr/bin/docker stop --time 120 qwen38-flash-next
Restart=on-failure
RestartSec=15
TimeoutStartSec=1800
TimeoutStopSec=180

[Install]
WantedBy=default.target
