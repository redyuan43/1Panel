# Qwen3.8-27B-EfficientThink W4A16 (modelopt NVFP4) + native MTP2 — V100-class TP4 production
# Switched to EfficientThink on 2026-09-09 and to NUMA1 GPU4-7 TP4 on 2026-09-10.
# Consumed by deploy/qwen38-et-v100/scripts wrappers via systemd EnvironmentFile.
# LMCache derives visible device indices and GPU worker count from GPU_UUIDS.
SERVER_BIN=/home/ai/venvs/1cat-vllm-1.5.0-lmcache/bin/vllm
CONTAINER_NAME=qwen38-v100-tp2-vllm
CONTAINER_IMAGE=docker.io/nvidia/cuda@sha256:520292dbb4f755fd360766059e62956e9379485d9e073bbd2f6e3c20c270ed66
PYTHON_RUNTIME=/home/ai/runtimes/python-3.12.14-20260901
VLLM_VENV=/home/ai/venvs/1cat-vllm-1.5.0
LMCACHE_VENV=/home/ai/venvs/1cat-vllm-1.5.0-lmcache
MODEL_PATH=/home/ai/models/Qwen38-EfficientThink-W4A16
DRAFT_MODEL_PATH=
SERVED_MODEL_NAME=siyuan/qwen38-v100-196k
GPU_UUIDS=GPU-008619db-68ab-5b8f-bf82-8fcd838af68b,GPU-cc874591-ffb9-839d-8f63-23e8613bc0e6,GPU-0b6da4b4-2e60-68e2-f402-0308bcf8215c,GPU-1d45793f-3157-fff0-9ade-d329ed7797c0
PIPELINE_PARALLEL_SIZE=1
TENSOR_PARALLEL_SIZE=4
HOST=127.0.0.1
PORT=18107
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.93
KV_CACHE_DTYPE=fp8_e5m2
ATTENTION_BACKEND=FLASH_ATTN_V100
ENFORCE_EAGER=0
DISABLE_CUSTOM_ALL_REDUCE=1
NCCL_P2P_DISABLE=1
SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":2}
VLLM_SM70_QUANT_BACKEND=auto
VLLM_USE_NVFP4_CT_EMULATIONS=0
VLLM_BATCH_INVARIANT=0
VLLM_CACHE_ROOT=/home/ai/.cache/1cat-vllm-1.5.0
CONTAINER_HOME=/home/ai/.cache/1cat-vllm-1.5.0/home

# LMCache re-disabled 2026-09-12 ~14:50 after safe-domain experiment: BOTH 1-chunk
# AND 2-chunk (3200-token) external hits return scrambled markers; only FULL-prefix
# (3-chunk, 4800-token) readback is correct. min_retrieve_tokens is NOT implemented
# in MP mode (grep of lmcache 0.5.4 MP stack: zero references). Safe-domain via
# threshold config is impossible without a patch. Evidence: aligned-prefill-safedomain-*.json
LMCACHE_ENABLED=0
BASE_VLLM_VENV=/home/ai/venvs/1cat-vllm-1.5.0-lmcache
